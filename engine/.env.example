# Control plane
SPREADSHEET_ID=
POLL_SECONDS=20
DRY_RUN=true
PORT=8080

# Gemini / Veo
GEMINI_API_KEY=

# Google Sheets auth: choose ONE strategy
# 1) Service-account JSON (raw JSON or base64)
GOOGLE_SERVICE_ACCOUNT_JSON=
# 2) OAuth refresh token
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# 3) Short-lived token injected by Workload Identity / CI
GOOGLE_ACCESS_TOKEN=

# Media
MEDIA_ROOT=/data/media
PUBLIC_MEDIA_BASE_URL=
MEDIA_ACCESS_TOKEN=change-me-long-random-token
